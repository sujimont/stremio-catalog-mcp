# Core MCP & Stremio Credentials
MCP_API_KEY=generate-a-long-random-secret
PUBLIC_BASE_URL=https://catalog.example.com
STREMIO_FEED_TOKEN=generate-a-different-long-random-secret

# Redis Storage (Upstash REST API)
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=configure-in-vercel-secrets

# Stremio Account Sync & Watch History (Optional)
# Enables automatic manifest sync, home layout ordering, addon management, and library history.
STREMIO_AUTH_KEY=your-stremio-auth-key

# TorBox Debrid Cloud Ingestion & Cache Pre-checker (Optional)
# Enables automatic magnet ingestion, torrent forum crawling, and cloud cache checking.
TORBOX_API_KEY=your-torbox-api-key

# TMDB Deep Discovery & Regional Cinema (Optional)
# Enables regional cinema filtering (Tamil, Malayalam, Hindi, Korean), OTT provider filters, and similar titles.
TMDB_API_KEY=your-tmdb-api-key

# Smart TV & Home Assistant Integration (Optional)
# TV_WEBHOOK_URL is the operator-trusted webhook – it may be a LAN address (http://homeassistant.local:8123/...).
# This is the ONLY way to use a LAN or Home Assistant URL, because webhooks registered via the
# devices_manage tool must be public HTTPS URLs (SSRF protection applies to those).
TV_WEBHOOK_URL=http://homeassistant.local:8123/api/webhook/stremio_play
# Optional JSON array of configured TV devices.  webhook_url values here must be public HTTPS.
# LAN webhook targets for these devices should be handled via TV_WEBHOOK_URL instead.
# Example: [{"name":"Living Room TV","alias":"living_room","ip":"192.168.1.50","platform":"android_tv"}]
TV_DEVICES_JSON=
